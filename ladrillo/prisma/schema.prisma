generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model catalogo_especie {
  id_especie     Int       @id @default(autoincrement())
  nombre_especie String    @unique @db.VarChar(50)
  mascota        mascota[]
}

model catalogo_ropa {
  id_prenda            Int                    @id @default(autoincrement())
  nombre_prenda        String                 @db.VarChar(100)
  categoria            String?                @db.VarChar(50)
  url_asset            String?                @db.VarChar(255)
  mascota_virtual_item mascota_virtual_item[]
}

model clinica_favorita {
  id_clinica_fav  Int     @id @default(autoincrement())
  id_usuario      Int
  google_place_id String  @db.VarChar(255)
  nombre_clinica  String? @db.VarChar(150)
  notas_usuario   String?
  usuario         usuario @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
}

model historial_medico {
  id_evento           Int      @id @default(autoincrement())
  id_mascota          Int
  tipo_evento         String?  @db.VarChar(100)
  fecha_evento        DateTime @db.Date
  descripcion         String?
  veterinario_clinica String?  @db.VarChar(150)
  peso_kg             Decimal? @db.Decimal(5, 2)
  mascota             mascota  @relation(fields: [id_mascota], references: [id_mascota], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_mascota], map: "idx_historial_mascota")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model mascota {
  id_mascota         Int                @id @default(autoincrement())
  id_usuario         Int
  id_especie         Int
  nombre             String             @db.VarChar(100)
  raza               String?            @db.VarChar(100)
  fecha_nacimiento   DateTime?          @db.Date
  sexo               String?            @db.Char(1)
  color              String?            @db.VarChar(100)
  senas_particulares String?
  historial_medico   historial_medico[]
  catalogo_especie   catalogo_especie   @relation(fields: [id_especie], references: [id_especie], onDelete: NoAction, onUpdate: NoAction)
  usuario            usuario            @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)
  mascota_virtual    mascota_virtual?
  recordatorio       recordatorio[]
  vacuna             vacuna[]

  @@index([id_usuario], map: "idx_mascota_usuario")
}

model mascota_virtual {
  id_mascota_virtual   Int                    @id @default(autoincrement())
  id_mascota           Int                    @unique
  mascota              mascota                @relation(fields: [id_mascota], references: [id_mascota], onDelete: Cascade, onUpdate: NoAction)
  mascota_virtual_item mascota_virtual_item[]
}

model mascota_virtual_item {
  id_registro        Int             @id @default(autoincrement())
  id_mascota_virtual Int
  id_prenda          Int
  slot               String          @db.VarChar(50)
  mascota_virtual    mascota_virtual @relation(fields: [id_mascota_virtual], references: [id_mascota_virtual], onDelete: Cascade, onUpdate: NoAction)
  catalogo_ropa      catalogo_ropa   @relation(fields: [id_prenda], references: [id_prenda], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_mascota_virtual, slot])
}

model recordatorio {
  id_recordatorio  Int      @id @default(autoincrement())
  id_mascota       Int
  titulo           String   @db.VarChar(150)
  fecha_hora       DateTime @db.Timestamp(6)
  id_evento_google String?  @db.VarChar(255)
  estado           Boolean? @default(false)
  mascota          mascota  @relation(fields: [id_mascota], references: [id_mascota], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_mascota], map: "idx_recordatorio_mascota")
}

model usuario {
  id_usuario           Int                @id @default(autoincrement())
  nombre_completo      String             @db.VarChar(150)
  correo               String             @unique @db.VarChar(150)
  password             String?            @db.VarChar(255)
  google_id            String?            @unique @db.VarChar(255)
  google_refresh_token String?
  telefono             String?            @db.VarChar(20)
  direccion            String?            @db.VarChar(255)
  fecha_registro       DateTime?          @default(now()) @db.Timestamp(6)
  clinica_favorita     clinica_favorita[]
  mascota              mascota[]
}

model vacuna {
  id_vacuna        Int       @id @default(autoincrement())
  id_mascota       Int
  nombre_vacuna    String    @db.VarChar(150)
  fecha_aplicacion DateTime  @db.Date
  proxima_dosis    DateTime? @db.Date
  lote             String?   @db.VarChar(100)
  mascota          mascota   @relation(fields: [id_mascota], references: [id_mascota], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_mascota], map: "idx_vacuna_mascota")
}
