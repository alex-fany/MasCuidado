generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CatalogoEspecie {
  id            Int       @id @default(autoincrement()) @map("id_especie")
  nombreEspecie String    @unique @map("nombre_especie") @db.VarChar(50)
  mascotas      Mascota[]

  @@map("catalogo_especie")
}

model ConfiguracionNutricion {
  id             String   @id @default(uuid()) @map("id_config_nutricion")
  mascotaId      String   @unique @map("id_mascota")
  metaAguaDiaria Int      @default(4) @map("meta_agua_diaria")
  reinicioAguaDias Int    @default(1) @map("reinicio_agua_dias")
  creadoEn       DateTime @default(now()) @map("creado_en")
  actualizadoEn  DateTime @updatedAt @map("actualizado_en")
  porcionDiaria  Float    @default(0) @map("porcion_diaria")
  unidadMedida   String   @default("g") @map("unidad_medida") @db.VarChar(10)
  mascota        Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@map("configuracion_nutricion")
}

model InventarioAlimento {
  id               String   @id @default(uuid()) @map("id_inventario")
  mascotaId        String   @map("id_mascota")
  marca            String   @map("marca") @db.VarChar(100)
  tipo             String   @map("tipo") @db.VarChar(50)
  fechaCompra      DateTime @default(now()) @map("fecha_compra")
  costo            Decimal? @map("costo") @db.Decimal(10, 2)
  estado           String   @default("Activo") @map("estado") @db.VarChar(20)
  cantidadRestante Float    @map("cantidad_restante")
  cantidadTotal    Float    @map("cantidad_total")
  unidadMedida     String   @default("g") @map("unidad_medida") @db.VarChar(10)
  mascota          Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  compartidoCon    CompartirAlimento[]

  @@map("inventario_alimento")
}

model CompartirAlimento {
  id                String             @id @default(uuid()) @map("id_compartir")
  inventarioId      String             @map("id_inventario")
  mascotaId         String             @map("id_mascota")
  inventario        InventarioAlimento @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  mascota           Mascota            @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@unique([inventarioId, mascotaId])
  @@map("compartir_alimento")
}

model RegistroHidratacion {
  id        String   @id @default(uuid()) @map("id_registro_agua")
  mascotaId String   @map("id_mascota")
  fechaHora DateTime @default(now()) @map("fecha_hora")
  cantidad  Int      @default(1) @map("cantidad_tazones")
  mascota   Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([mascotaId, fechaHora])
  @@map("registro_hidratacion")
}

model ClinicaFavorita {
  id           String   @id @default(uuid()) @map("id_clinica_fav")
  placeId      String   @map("google_place_id") @db.VarChar(255)
  nombre       String?  @map("nombre_clinica") @db.VarChar(150)
  notasUsuario String?  @map("notas_usuario")
  creadoEn     DateTime @default(now()) @map("creado_en")
  direccion    String?  @map("direccion") @db.VarChar(255)
  mascotaId    String   @map("id_mascota")
  mascota      Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@map("clinica_favorita")
}

model HistorialMedico {
  id                 String   @id @default(uuid()) @map("id_evento")
  mascotaId          String   @map("id_mascota")
  tipoEvento         String?  @map("tipo_evento") @db.VarChar(100)
  fechaEvento        DateTime @map("fecha_evento") @db.Date
  descripcion        String?  @map("descripcion")
  veterinarioClinica String?  @map("veterinario_clinica") @db.VarChar(150)
  pesoKg             Decimal? @map("peso_kg") @db.Decimal(5, 2)
  creadoEn           DateTime @default(now()) @map("creado_en")
  mascota            Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([mascotaId], map: "idx_historial_mascota")
  @@map("historial_medico")
}

model Mascota {
  id                   String                  @id @default(uuid()) @map("id_mascota")
  usuarioId            String                  @map("id_usuario")
  especieId            Int?                    @map("id_especie")
  nombre               String                  @map("nombre") @db.VarChar(100)
  fechaNacimiento      DateTime?               @map("fecha_nacimiento") @db.Date
  sexo                 String?                 @map("sexo") @db.Char(1)
  color                String?                 @map("color") @db.VarChar(100)
  senasParticulares    String?                 @map("senas_particulares")
  creadoEn             DateTime                @default(now()) @map("creado_en")
  genero               String?                 @map("genero")
  peso                 Float?                  @map("peso")
  tipo                 String?                 @map("tipo") @db.VarChar(50)
  edad                 Int?                    @map("edad")
  imagen               String?                 @map("imagen")
  raza                 String?                 @map("raza") @db.VarChar(100)
  medicamentos         String?                 @map("medicamentos")
  padecimientos        String?                 @map("padecimientos")
  fotosCartilla        Json?                   @map("fotos_cartilla")
  clinicasFavoritas    ClinicaFavorita[]
  nutricionConfig      ConfiguracionNutricion?
  historialMedico      HistorialMedico[]
  inventariosAlimento  InventarioAlimento[]
  especie              CatalogoEspecie?        @relation(fields: [especieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario              Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  recordatorios        Recordatorio[]
  registrosHidratacion RegistroHidratacion[]
  vacunas              Vacuna[]
  compartirAlimento    CompartirAlimento[]

  @@index([usuarioId], map: "idx_mascota_usuario")
  @@map("mascota")
}

model Recordatorio {
  id             Int      @id @default(autoincrement()) @map("id_recordatorio")
  mascotaId      String   @map("id_mascota")
  titulo         String   @map("titulo") @db.VarChar(150)
  fechaHora      DateTime @map("fecha_hora") @db.Timestamp(6)
  idEventoGoogle String?  @map("id_evento_google") @db.VarChar(255)
  estado         Boolean? @default(false) @map("estado")
  descripcion    String?  @map("descripcion")
  usuarioId      String   @map("id_usuario")
  mascota        Mascota  @relation(fields: [mascotaId], references: [id], onDelete: Cascade)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([mascotaId], map: "idx_recordatorio_mascota")
  @@index([usuarioId], map: "idx_recordatorio_usuario")
  @@map("recordatorio")
}

model Usuario {
  id                 String         @id @default(uuid()) @map("id_usuario")
  nombreCompleto     String         @map("nombre_completo") @db.VarChar(150)
  correo             String         @unique @map("correo") @db.VarChar(150)
  password           String?        @map("password") @db.VarChar(255)
  googleId           String?        @unique @map("google_id") @db.VarChar(255)
  googleRefreshToken String?        @map("google_refresh_token")
  telefono           String?        @map("telefono") @db.VarChar(20)
  fechaRegistro      DateTime?      @default(now()) @map("fecha_registro") @db.Timestamp(6)
  imagen             String?        @map("imagen")
  colorAvatar        String?        @default("#2d9b96") @map("color_avatar") @db.VarChar(7)
  estado             String         @default("Activo") @map("estado") @db.VarChar(20)
  mascotas           Mascota[]
  recordatorios      Recordatorio[]
  settings           UserSettings?

  @@map("usuario")
}

model UserSettings {
  id       String  @id @default(uuid()) @map("id_settings")
  userId   String  @unique @map("id_usuario")
  theme    String  @default("light") @db.VarChar(20)
  language String  @default("es") @db.VarChar(10)
  user     Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Vacuna {
  id              Int       @id @default(autoincrement()) @map("id_vacuna")
  mascotaId       String    @map("id_mascota")
  nombreVacuna    String    @map("nombre_vacuna") @db.VarChar(150)
  fechaAplicacion DateTime  @map("fecha_aplicacion") @db.Date
  proximaDosis    DateTime? @map("proxima_dosis") @db.Date
  lote            String?   @map("lote") @db.VarChar(100)
  mascota         Mascota   @relation(fields: [mascotaId], references: [id], onDelete: Cascade)

  @@index([mascotaId], map: "idx_vacuna_mascota")
  @@map("vacuna")
}
